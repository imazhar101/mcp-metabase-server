{
  "name": "@imazhar101/mcp-metabase-server",
  "version": "1.3.2",
  "description": "MCP server for Metabase — fork of @easecloudio/mcp-metabase-server with list_tables/get_database_tables fixed for current Metabase API (GET /api/database/{id}/tables was removed; now GET /api/database/{id}?include=tables)",
  "author": "Azhar Sirajuddin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/imazhar101/mcp-metabase-server.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/imazhar101/mcp-metabase-server",
  "bugs": {
    "url": "https://github.com/imazhar101/mcp-metabase-server/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "metabase",
    "analytics",
    "business-intelligence",
    "ai",
    "claude",
    "dashboard",
    "sql",
    "mbql",
    "bi"
  ],
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mcp-metabase-server": "./dist/index.js",
    "mcp-metabase": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\" && mkdir -p dist && cp -r build/* dist/",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js",
    "start": "node dist/index.js",
    "dev": "npm run build && npm start",
    "clean": "rm -rf build dist",
    "test": "npm run build && echo 'Tests would go here'",
    "lint": "echo 'Linting would go here'",
    "docker:build": "docker build -t mcp-metabase-server .",
    "docker:run": "docker run -it --rm mcp-metabase-server",
    "docker:compose": "docker-compose up"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.6.1",
    "abort-controller": "3.0.0",
    "axios": "1.10.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.17.22",
    "typescript": "5.3.3"
  }
}
